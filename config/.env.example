# =====================================================================
# StickForge 2D - Server Environment Configuration
# Copy this file to .env or set environment variables on your web host
# =====================================================================

# Google Gemini API Key (Get free key at: https://aistudio.google.com/)
GEMINI_API_KEY=

# Default Gemini Model (Recommended: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Google Image Generation Models (gemini-3.1-flash-image, imagen-4.0-generate-001)
IMAGE_MODEL=gemini-3.1-flash-image
IMAGEN_MODEL=imagen-4.0-generate-001

# OpenAI API Key (Optional - for DALL-E 3 and OpenAI TTS)
OPENAI_API_KEY=

# ElevenLabs API Key (Optional - for ultra-realistic voiceovers)
ELEVENLABS_API_KEY=

# Security & Client Permissions
# Set to 'true' to allow users to override server keys with their own (BYOK)
ALLOW_CLIENT_BYOK=true

# Server Project Storage Directory (Relative to /api or absolute path)
PROJECTS_STORAGE_PATH=../data/projects

# Allowed CORS Origins ('*' for all or your production domain e.g. https://yourdomain.com)
CORS_ALLOWED_ORIGIN=*

# =====================================================================
# Amazon Aurora RDS (Relational Database Service) Key Storage
# Stores API keys in an Amazon Aurora PostgreSQL or MySQL cluster
# =====================================================================

# Set to true to activate Aurora RDS as the primary key vault
AURORA_RDS_ENABLED=false

# Database Engine: 'postgres' (default) or 'mysql'
AURORA_RDS_ENGINE=postgres

# Aurora RDS Cluster Endpoint (from AWS RDS Management Console)
# e.g., my-cluster.cluster-c123456789.us-east-1.rds.amazonaws.com
AURORA_RDS_HOST=

# Database Connection Settings
# Port defaults: 5432 for Aurora PostgreSQL, 3306 for Aurora MySQL
AURORA_RDS_PORT=5432
AURORA_RDS_DATABASE=stickforge
AURORA_RDS_USER=postgres
AURORA_RDS_PASSWORD=

# SSL Mode for PostgreSQL: 'prefer' or 'require' (recommended in production)
AURORA_RDS_SSL=prefer

# Optional: IAM Database Authentication (if not using master password)
AURORA_RDS_REGION=us-east-1
AURORA_RDS_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
